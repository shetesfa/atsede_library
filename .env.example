# ==========================================
# Atsede Library - Environment Configuration
# ==========================================
# For Render.com, copy these key-values into:
# Dashboard -> Service -> Environment -> "Add from .env"

APP_ENV=production

# TiDB Cloud Serverless (MySQL Compatible)
DB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=3Xn9qgPVFn4i7vZ.root
DB_PASS=your_tidb_password_here
DB_NAME=atsede_library
DB_SSL=true

# GitHub Persistent Storage for Book Covers
GITHUB_REPO=shetesfa/atsede_library
GITHUB_BRANCH=main
GITHUB_TOKEN=your_github_personal_access_token_here

# Telegram Bot (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
